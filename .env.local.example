# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and read by `npm run refresh-live` only — never bundled.
#
# Same Supabase project the deal-intelligence-web Flask app reads from.
# Get the URL and an anon key (or service-role key if RLS blocks aggregate reads)
# from the Supabase project dashboard.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: use the service-role key instead if RLS prevents aggregate selects
# with the anon key. Service-role bypasses RLS entirely. The script runs locally
# or in GitHub Actions only — this key never ships to the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
